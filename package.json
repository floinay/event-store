{
  "name": "event-store",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.3.0",
  "engines": {
    "node": "24.18.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "npm run build && vitest run",
    "test:unit": "npm run build && vitest run tests/unit",
    "test:integration": "npm run build && RUN_INTEGRATION=true vitest run --no-file-parallelism tests/sql-contract tests/integration",
    "lint": "eslint .",
    "format": "prettier --check .",
    "migrate": "npm run build && node tools/migrate/dist/index.js",
    "bootstrap": "npm run build && node tools/bootstrap/dist/index.js",
    "reconcile": "npm run build && node tools/reconcile/dist/index.js",
    "pitr:verify": "npm run build && node tools/pitr-verify/dist/index.js",
    "replay:connector": "npm run build && node tools/replay/dist/index.js",
    "benchmark": "npm run build && node tools/benchmark/dist/index.js"
  },
  "devDependencies": {
    "@confluentinc/kafka-javascript": "1.10.0",
    "@testcontainers/toxiproxy": "^12.0.4",
    "@types/node": "24.10.1",
    "@typescript-eslint/eslint-plugin": "8.46.4",
    "@typescript-eslint/parser": "8.46.4",
    "eslint": "9.39.1",
    "fast-check": "4.9.0",
    "globals": "14.0.0",
    "prettier": "3.6.2",
    "testcontainers": "12.0.4",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
